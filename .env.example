# ORCA ROUTER direct provider (optional)
# Obtain a new key from ORCA ROUTER. Never copy a key into this file or source code.
ORCAROUTER_API_KEY=

# Optional direct audio analysis. It is disabled unless this is exactly "yes".
# The UI requires confirmation for every send, accepts only a <=30 second
# microphone recording, and does not persist raw audio in this application.
CONNECT_FORCE_ENABLE_AUDIO_SEND=no
ORCA_AUDIO_MODEL=google/gemini-2.5-flash
# Comma-separated organization-approved models. A model outside this list is rejected.
CONNECT_FORCE_AUDIO_ALLOWED_MODELS=google/gemini-2.5-flash
# Leave blank when ffmpeg is on PATH. The server fails closed if duration cannot be measured.
FFMPEG_PATH=
# Per login session: request-rate, daily count, and conservative reserved-cost cap.
CONNECT_FORCE_AUDIO_MAX_REQUESTS_PER_MINUTE=2
CONNECT_FORCE_AUDIO_MAX_REQUESTS_PER_DAY=6
CONNECT_FORCE_AUDIO_MAX_RESERVED_USD_PER_DAY=0.06
CONNECT_FORCE_AUDIO_RESERVE_USD_PER_REQUEST=0.01
# Upper bound for a single audio-analysis text response (16-300).
CONNECT_FORCE_AUDIO_MAX_OUTPUT_TOKENS=300

# Optional live eval gate. Keep "no" for normal verification.
CONNECT_FORCE_RUN_LIVE_EVALS=no
CONNECT_FORCE_RUN_LIVE_AUDIO_EVALS=no

# Optional local periodic check targets (anonymous object IDs, max 20).
CONNECT_FORCE_PERIODIC_OBJECT_IDS=

# Optional external data roots. Use absolute paths managed by the launcher/deployment,
# never values supplied from the browser. Defaults retain the existing local layout.
CONNECT_FORCE_VAULT_ROOT=
CONNECT_FORCE_CARD_DRAFT_ROOT=
CONNECT_FORCE_MISSION_DRAFT_ROOT=

# Optional paid model escalation. "no" preserves low-cost/local-only behavior.
CONNECT_FORCE_ENABLE_PAID_FALLBACK=no
CONNECT_FORCE_ENABLE_SONNET_ESCALATION=no

# Optional Claude direct API for paid fallbacks. Never put a value in this file.
ANTHROPIC_API_KEY=
